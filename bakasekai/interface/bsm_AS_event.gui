# ==========================================
# BSM アノマリー発見ポップアップ GUI
# window_name = bsm_AS_event_window
# レイアウト元: BSM_AS.drawio（イベント画面（素材入り））
# 画像はカテゴリー別（7種を可視性で切替）
# ==========================================
guiTypes = {
	containerWindowType = {
		name = "bsm_AS_event_window"
		position = { x = 400 y = 170 }
		size = { width = 520 height = 420 }
		moveable = yes

		show_sound = menu_open_window
		hide_sound = menu_close_window

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window2_1b_border"
		}

		iconType = {
			name = "bsm_AS_event_header_bg"
			spriteType = "GFX_header_bg"
			position = { x = 5 y = 7 }
			Orientation = UPPER_LEFT
		}
		instantTextboxType = {
			name = "bsm_AS_event_title"
			position = { x = 20 y = 12 }
			font = "hoi_20b"
			text = "bsm_AS_event_title"
			maxWidth = 480 maxHeight = 26
			format = left
		}

		# ------- カテゴリー別 4:3 画像（可視性で1枚だけ表示） -------
