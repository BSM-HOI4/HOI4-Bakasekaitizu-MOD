# ==========================================
# BSM ステラリス要素 GUI（伝統・アセンション・特性）
# prefix: bsm_stellaris_
# window_name = bsm_stellaris_window
# タブ無し・1画面表示（EA並みサイズ）／Stellaris風レイアウト
#   左カラム = 伝統7ツリー / 右上 = アセンションパーク8 / 右下 = 特性
# ==========================================

guiTypes = {
	containerWindowType = {
		name = "bsm_stellaris_window"
		position = { x = -460 y = -340 }
		orientation = center
		size = { width = 920 height = 680 }
		moveable = yes
		click_to_front = yes

		show_sound = menu_open_window
		hide_sound = menu_close_window

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window_1b_border"
		}

