spriteTypes = {
	# ==========================================
	# BSM 国家通貨アイコン (75x40 px)
	# 3段階: 通常 / 強い(strong) / 弱い(weak)
	# 画像配置: gfx/currency/{CURRENCY}.png / _strong.png / _weak.png
	# ==========================================
	# NOTE: GUI上では scripted_localisation の GetNCIcon から
	#       £nc_* テキストアイコンとして参照する。
	#       texturefile が存在しないスプライトを定義すると error.log に
	#       missing-texture が出るため、PNG が実在する通貨のみ定義する。

	# --- 1: USD (米ドル) ---
	spriteType = { name = "GFX_nc_usd" texturefile = "gfx/currency/USD.png" }
	spriteType = { name = "GFX_nc_usd_strong" texturefile = "gfx/currency/USD_strong.png" }
	spriteType = { name = "GFX_nc_usd_weak" texturefile = "gfx/currency/USD_weak.png" }

	# --- 2: EUR (ユーロ) ---
	spriteType = { name = "GFX_nc_eur" texturefile = "gfx/currency/EUR.png" }
	spriteType = { name = "GFX_nc_eur_strong" texturefile = "gfx/currency/EUR_strong.png" }
	spriteType = { name = "GFX_nc_eur_weak" texturefile = "gfx/currency/EUR_weak.png" }

	# --- 3: GBP (ポンド) ---
	spriteType = { name = "GFX_nc_gbp" texturefile = "gfx/currency/GBP.png" }
	spriteType = { name = "GFX_nc_gbp_strong" texturefile = "gfx/currency/GBP_strong.png" }
	spriteType = { name = "GFX_nc_gbp_weak" texturefile = "gfx/currency/GBP_weak.png" }

	# --- 4: JPY (円) ---
	spriteType = { name = "GFX_nc_jpy" texturefile = "gfx/currency/JPY.png" }
	spriteType = { name = "GFX_nc_jpy_strong" texturefile = "gfx/currency/JPY_strong.png" }
	spriteType = { name = "GFX_nc_jpy_weak" texturefile = "gfx/currency/JPY_weak.png" }

	# --- 5: CNY (人民元) ---
	spriteType = { name = "GFX_nc_cny" texturefile = "gfx/currency/CNY.png" }
	spriteType = { name = "GFX_nc_cny_strong" texturefile = "gfx/currency/CNY_strong.png" }
	spriteType = { name = "GFX_nc_cny_weak" texturefile = "gfx/currency/CNY_weak.png" }

	# --- 6: RUB (ルーブル) ---
	spriteType = { name = "GFX_nc_rub" texturefile = "gfx/currency/RUB.png" }
	spriteType = { name = "GFX_nc_rub_strong" texturefile = "gfx/currency/RUB_strong.png" }
	spriteType = { name = "GFX_nc_rub_weak" texturefile = "gfx/currency/RUB_weak.png" }

	# --- 7: KRW (ウォン) ---
	spriteType = { name = "GFX_nc_krw" texturefile = "gfx/currency/KRW.png" }
	spriteType = { name = "GFX_nc_krw_strong" texturefile = "gfx/currency/KRW_strong.png" }
	spriteType = { name = "GFX_nc_krw_weak" texturefile = "gfx/currency/KRW_weak.png" }

	# --- 8: INR (ルピー) ---
	spriteType = { name = "GFX_nc_inr" texturefile = "gfx/currency/INR.png" }
	spriteType = { name = "GFX_nc_inr_strong" texturefile = "gfx/currency/INR_strong.png" }
	spriteType = { name = "GFX_nc_inr_weak" texturefile = "gfx/currency/INR_weak.png" }

	# --- 9: TRY (リラ) ---
	spriteType = { name = "GFX_nc_try" texturefile = "gfx/currency/TRY.png" }
	spriteType = { name = "GFX_nc_try_strong" texturefile = "gfx/currency/TRY_strong.png" }
