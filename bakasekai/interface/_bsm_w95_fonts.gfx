# BSM Win95/98 frontend retexture: black-coloured fonts.
# Reuse BSM's Japanese-capable jis glyph files but render BLACK, so all frontend
# text is readable on the light silver Win95 panels (authentic gray Win95: black
# text on light gray, no blue active title bars).
bitmapfonts = {
	bitmapfont = {
		name = "bsm_16_blk"          # body / buttons (was hoi_16mbs/18mbs/20b/20bs)
		fontfiles = { "gfx/fonts/jis16_b" "gfx/fonts/jis16_b_2" }
		color = 0xff000000
		textcolors = { G = { 24 112 26 } R = { 124 24 24 } Y = { 0 0 0 } H = { 70 70 70 } T = { 255 255 255 } }
	}
	bitmapfont = {
		name = "bsm_16mbs_blk"       # hoi_16mbs と同じ jis16 字形のまま黒（明色パネルで可読）
		fontfiles = { "gfx/fonts/jis16" "gfx/fonts/jis16_2" }
		color = 0xff000000
		textcolors = { G = { 24 112 26 } R = { 124 24 24 } Y = { 0 0 0 } H = { 70 70 70 } T = { 255 255 255 } }
	}
	bitmapfont = {
		name = "bsm_24_blk"          # headers / titles (was hoi_24header)
		fontfiles = { "gfx/fonts/bsm_jis_24" }
		color = 0xff000000
		textcolors = { G = { 24 112 26 } R = { 124 24 24 } Y = { 0 0 0 } H = { 70 70 70 } T = { 255 255 255 } }
	}
	bitmapfont = {
		name = "bsm_30_blk"          # big headers (was hoi_30header/36header)
		fontfiles = { "gfx/fonts/jis30" "gfx/fonts/jis30_2" }
		color = 0xff000000
		textcolors = { G = { 24 112 26 } R = { 124 24 24 } Y = { 0 0 0 } H = { 70 70 70 } T = { 255 255 255 } }
	}
	# --- 東雲ゴシック12 (小ゴシック body)。jiskan系の見出しと対比させる ---
	bitmapfont = {
		name = "bsm_shinonome"       # 小ゴシック body / list / buttons (黒・明色背景用)
		fontfiles = { "gfx/fonts/shinonome12" }
		color = 0xff000000
		textcolors = { G = { 24 112 26 } R = { 124 24 24 } Y = { 0 0 0 } H = { 70 70 70 } T = { 255 255 255 } }
	}
	bitmapfont = {
		name = "bsm_shinonome_w"     # 小ゴシック (白・暗色/青背景用)
		fontfiles = { "gfx/fonts/shinonome12" }
		color = 0xffffffff
		textcolors = { G = { 86 172 91 } R = { 222 86 70 } Y = { 238 201 35 } H = { 238 201 35 } T = { 255 255 255 } }
	}
}
