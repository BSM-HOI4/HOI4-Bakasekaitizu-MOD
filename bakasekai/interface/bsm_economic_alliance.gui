guiTypes = {
	# Main Window
	containerWindowType = {
		name = "bsm_economic_alliance_window"
		position = { x = -250 y = -300 } # Higher up to fit more content
		orientation = center
		size = { width = 500 height = 600 } # Taller
		
		moveable = yes
		click_to_front = yes

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window_1b_border"
		}

		buttonType = {
			name = "bsm_close_ea_window_button"
			position = { x = -43 y = 15 }
			quadTextureSprite = "GFX_closebutton"
			buttonFont = "hoi_16mbs"
			shortcut = "ESCAPE"
			Orientation = "UPPER_RIGHT"
			clicksound = click_close
			pdx_tooltip = "CLOSE"
		}

		# Title
		instantTextboxType = {
			name = "title"
			position = { x = 0 y = 15 }
			font = "bsm_24h"
			text = "BSM_ECONOMIC_ALLIANCE_INFO_TITLE"
			maxWidth = 500
			format = center
		}

		# --- Player's Alliances Section ---
		instantTextboxType = {
			name = "my_alliances_header"
			position = { x = 20 y = 50 }
			font = "hoi_16mbs"
			text = "BSM_EA_MY_ALLIANCES_HEADER"
			maxWidth = 460
			format = left
		}

		# Player's Alliances List Container
		containerWindowType = {
			name = "player_alliance_list_container"
			position = { x = 20 y = 75 }
			size = { width = 460 height = 60 }
			verticalScrollbar = "right_vertical_slider"

			background = {
				name = "Background"
				quadTextureSprite = "GFX_tiled_window_transparent"
			}

			gridBoxType = {
				name = "economic_alliance_player_list"
				position = { x = 0 y = 0 }
				size = { width = 440 height = 100% }
				slotsize = { width = 440 height = 30 }
				format = "UPPER_LEFT"
				max_slots_horizontal = 1
			}
		}

		# --- Selected Alliance Members Section ---
		instantTextboxType = {
			name = "members_header"
			position = { x = 20 y = 145 }
			font = "hoi_16mbs"
			text = "BSM_EA_MEMBERS_HEADER"
			maxWidth = 460
			format = left
		}

		# Members List Container
		containerWindowType = {
			name = "member_list_container"
			position = { x = 20 y = 170 }
			size = { width = 460 height = 80 }
			verticalScrollbar = "right_vertical_slider"

			background = {
				name = "Background"
				quadTextureSprite = "GFX_tiled_window_transparent"
			}

			gridBoxType = {
				name = "economic_alliance_member_list"
				position = { x = 0 y = 0 }
				size = { width = 440 height = 100% }
				slotsize = { width = 440 height = 30 }
				format = "UPPER_LEFT"
				max_slots_horizontal = 1
			}
		}

		# No Alliance Text (shown when not in any alliance)
		instantTextboxType = {
			name = "no_alliance_text"
			position = { x = 20 y = 85 }
			font = "hoi_16mbs"
			text = "[GetNoAllianceText]"
			maxWidth = 460
			format = center
		}

		# --- Global Ranking Section ---
		instantTextboxType = {
			name = "ranking_header"
			position = { x = 20 y = 260 }
			font = "hoi_16mbs"
			text = "BSM_EA_RANKING_HEADER"
			maxWidth = 460
			format = left
		}

		# Ranking Header Labels (Outside Scroll)
		containerWindowType = {
			name = "ranking_header_row"
			position = { x = 20 y = 285 }
			size = { width = 460 height = 20 }
			
			instantTextboxType = {
				name = "rank_label"
				position = { x = 10 y = 0 }
				font = "hoi_16mbs"
				text = "BSM_EA_RANK_LABEL"
				maxWidth = 50
				format = center
			}
			instantTextboxType = {
				name = "name_label"
				position = { x = 70 y = 0 }
				font = "hoi_16mbs"
				text = "BSM_EA_NAME_LABEL"
				maxWidth = 250
				format = left
			}
			instantTextboxType = {
				name = "power_label"
				position = { x = 330 y = 0 }
				font = "hoi_16mbs"
				text = "BSM_EA_POWER_LABEL"
				maxWidth = 100
				format = right
			}
		}

		# Ranking List (Scrollable)
		containerWindowType = {
			name = "ranking_container"
			position = { x = 20 y = 310 } # Adjusted Y down to make room for player & member lists
			size = { width = 460 height = 270 } # Adjusted height
			margin = { top = 0 bottom = 0 }
			verticalScrollbar = "right_vertical_slider"
			
			background = {
				name = "Background"
				quadTextureSprite = "GFX_tiled_window_transparent"
			}
			
			gridBoxType = {
				name = "economic_alliance_ranking_list"
				position = { x = 0 y = 0 }
				size = { width = 440 height = 100% }
				slotsize = { width = 460 height = 35 }
				format = "UPPER_LEFT"
				max_slots_horizontal = 1
			}
		}
	}

	# Entry: Player's Alliance (alliance the player is in)
	containerWindowType = {
		name = "economic_alliance_player_entry"
		position = { x = 0 y = 0 }
		size = { width = 460 height = 30 }

		# Background needs tooltip
		buttonType = {
			name = "entry_bg"
			position = { x = 0 y = 0 }
			quadTextureSprite = "GFX_tiled_plain_bg"
			size = { x=460 y=30 }
			pdx_tooltip = "[GetEATooltip]"
		}

		instantTextboxType = {
			name = "alliance_name"
			position = { x = 10 y = 6 }
			font = "bsm_16"
			text = "[THIS.GetFlag] [THIS.GetEAName]"
			maxWidth = 280
			format = left
			alwaystransparent = yes
		}

		instantTextboxType = {
			name = "alliance_members"
			position = { x = 320 y = 6 }
			font = "bsm_16"
			text = "[?bsm_ea_mem_count|Y0]"
			maxWidth = 50
			format = center
			alwaystransparent = yes
		}

		instantTextboxType = {
			name = "alliance_power"
			position = { x = 380 y = 6 }
			font = "bsm_16"
			text = "[?bsm_ea_total_power|Y0]"
			maxWidth = 60
			format = right
			alwaystransparent = yes
		}
	}

	# Entry: Member in Selected Alliance
	containerWindowType = {
		name = "economic_alliance_member_entry"
		position = { x = 0 y = 0 }
		size = { width = 460 height = 30 }

		# Background needs tooltip
		buttonType = {
			name = "entry_bg"
			position = { x = 0 y = 0 }
			quadTextureSprite = "GFX_tiled_plain_bg_small"
			size = { x=460 y=30 }
			pdx_tooltip = "BSM_EA_MEMBER_TOOLTIP"
		}

		instantTextboxType = {
			name = "member_name"
			position = { x = 10 y = 6 }
			font = "bsm_16"
			text = "[THIS.GetFlag] [THIS.GetName]"
			maxWidth = 290
			format = left
			alwaystransparent = yes
		}

		instantTextboxType = {
			name = "member_power"
			position = { x = 330 y = 6 }
			font = "bsm_16"
			text = "[?bsm_ea_member_power|Y0]"
			maxWidth = 110
			format = right
			alwaystransparent = yes
		}
	}

	# Entry: Ranking
	containerWindowType = {
		name = "economic_alliance_ranking_entry"
		position = { x = 0 y = 0 }
		size = { width = 460 height = 30 }

		buttonType = {
			name = "entry_bg"
			position = { x = 0 y = 0 }
			quadTextureSprite = "GFX_tiled_plain_bg_small"
			size = { x = 460 y = 30 }
			pdx_tooltip = "BSM_EA_RANKING_TOOLTIP"
		}

		instantTextboxType = {
			name = "rank"
			position = { x = 10 y = 6 }
			font = "bsm_16"
			text = "BSM_EA_RANK_VALUE"
			maxWidth = 50
			format = center
			alwaystransparent = yes
		}

		instantTextboxType = {
			name = "name"
			position = { x = 70 y = 6 }
			font = "bsm_16"
			text = "[THIS.GetFlag] [THIS.GetEAName]"
			maxWidth = 250
			format = left
			alwaystransparent = yes
			fixedsize = yes
		}

		instantTextboxType = {
			name = "power"
			position = { x = 330 y = 6 }
			font = "bsm_16"
			text = "BSM_EA_POWER_VALUE"
			maxWidth = 100
			format = right
			alwaystransparent = yes
		}
	}

	# Navigation Buttons (Multiple Spheres)
	containerWindowType = {
		name = "bsm_ea_nav_container"
		position = { x = 20 y = 50 } # Same Y as Header
		size = { width = 460 height = 30 }
		
		buttonType = {
			name = "bsm_ea_prev_button"
			position = { x = 300 y = -5 }
			quadTextureSprite = "GFX_browser_back" # Placeholder sprite, needs check
			scale = 0.8
			pdx_tooltip = "BSM_EA_PREV_TOOLTIP"
		}

		buttonType = {
			name = "bsm_ea_next_button"
			position = { x = 340 y = -5 }
			quadTextureSprite = "GFX_browser_forward" # Placeholder sprite, needs check
			scale = 0.8
			pdx_tooltip = "BSM_EA_NEXT_TOOLTIP"
		}
	}

	# Button Container
	containerWindowType = {
			name = "bsm_ea_button_container"
			position = { x = 380 y = 390 }
			size = { width = 200 height = 50 }

			buttonType = {
				name = "bsm_open_ea_window_button"
				position = { x = 0 y = 0 }
				quadTextureSprite = "GFX_government_button"
				buttonText = "BSM_OPEN_EA_GUI"
				buttonFont = "hoi_16mbs"
				Orientation = "UPPER_LEFT"
				clicksound = click_ok
				pdx_tooltip = "BSM_OPEN_EA_GUI_TT"
		}
	}
}
