guiTypes = {

	containerWindowType = {
		name ="frontend_background"
		position = { x=0 y =0 }	
		size = { 
			width = 1920 
			height = 1440 
			min = { width = 100% height = 100% }
			max = { width = 100% height = 10000 }
			preserve_aspect_ratio = yes
		}
		Orientation = center
		Origo = center
		clipping = no 
		
		background = {
			name = "Background"
			quadTextureSprite ="GFX_frontend_bg"
			alwaystransparent = yes
		}

		#BSM: カスタムメインメニュー背景(op.png)。エンジンが必ず生成する frontend_background の
		#子としてネストすることで確実に描画される(独自名トップレベル窓はエンジンに無視され描画されない)。
		#親背景(GFX_frontend_bg)の手前・別トップレベル窓のメニューパネル群の奥に出る。
		#親と同じフルサイズ指定でコンテナの background として描くため解像度非依存のカバー描画になる。
		containerWindowType = {
			name = "bsm_frontend_op_background"
			position = { x=0 y=0 }
			size = {
				width = 1920
				height = 1440
				min = { width = 100% height = 100% }
				max = { width = 100% height = 10000 }
				preserve_aspect_ratio = yes
			}
			Orientation = center
			Origo = center
			clipping = no

			background = {
				name = "Background"
				quadTextureSprite = "GFX_bsm_mainmenu_op"
				alwaystransparent = yes
			}
		}

	}

